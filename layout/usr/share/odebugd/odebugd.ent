<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  odebugd 的 entitlement。为什么需要：

	  LaunchDaemon 在 iOS 15+ 默认跑在沙盒里 —— 实测没有权限时：
	    · sysctl(KERN_PROC_ALL) 失败 ⇒ !ps 用不了、找不到 SpringBoard（pid=0）
	    · NSFileManager 读 /private/var/containers/Bundle/Application 返回空 ⇒ 连 jbroot 都找不着
	  这几条 entitlement 就是从真机上 /usr/sbin/frida-server.ent 里挑出来的最小集合
	  （frida-server 同为 LaunchDaemon，它能在安全模式下 attach 任何进程，正是我们要的能力）。
	-->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.skip-library-validation</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
	<key>com.apple.private.cs.debugger</key>
	<true/>
	<key>com.apple.private.thread-set-state</key>
	<true/>
	<key>dynamic-codesigning</key>
	<true/>
	<key>run-unsigned-code</key>
	<true/>
</dict>
</plist>
